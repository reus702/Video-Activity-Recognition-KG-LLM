@prefix reassemble: <https://example.org/reassemble/actions#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/reassemble/catalog> a owl:Ontology ;
    rdfs:seeAlso <https://arxiv.org/html/2502.05086> .

reassemble:datasetObjectLabel a owl:DatatypeProperty ;
    rdfs:domain reassemble:Piece ;
    rdfs:range xsd:string .

reassemble:Peg a owl:Class ;
    rdfs:subClassOf reassemble:Piece .
reassemble:Gear a owl:Class ;
    rdfs:subClassOf reassemble:Piece .
reassemble:ThreadedPart a owl:Class ;
    rdfs:subClassOf reassemble:Piece .
reassemble:PegHole a owl:Class ;
    rdfs:subClassOf reassemble:AssemblySite .
reassemble:GearMount a owl:Class ;
    rdfs:subClassOf reassemble:AssemblySite .
reassemble:ThreadedMount a owl:Class ;
    rdfs:subClassOf reassemble:AssemblySite .

# Intended board sites for the annotated pieces in the REASSEMBLE task.
# The BNC and its socket already have a compatibleSocket assertion in the action ontology.
reassemble:bnc reassemble:datasetObjectLabel "BNC" .

reassemble:dSub a reassemble:Connector ;
    reassemble:datasetObjectLabel "D-SUB" ;
    reassemble:compatibleSite reassemble:dSubSocket .
reassemble:dSubSocket a reassemble:Socket .

reassemble:ethernet a reassemble:Connector ;
    reassemble:datasetObjectLabel "Ethernet" ;
    reassemble:compatibleSite reassemble:ethernetSocket .
reassemble:ethernetSocket a reassemble:Socket .

reassemble:usb a reassemble:Connector ;
    reassemble:datasetObjectLabel "USB" ;
    reassemble:compatibleSite reassemble:usbSocket .
reassemble:usbSocket a reassemble:Socket .

reassemble:waterproof a reassemble:Connector ;
    reassemble:datasetObjectLabel "waterproof" ;
    reassemble:compatibleSite reassemble:waterproofSocket .
reassemble:waterproofSocket a reassemble:Socket .

reassemble:smallGear a reassemble:Gear ;
    reassemble:datasetObjectLabel "small gear" ;
    reassemble:compatibleSite reassemble:smallGearMount .
reassemble:smallGearMount a reassemble:GearMount .

reassemble:mediumGear a reassemble:Gear ;
    reassemble:datasetObjectLabel "medium gear" ;
    reassemble:compatibleSite reassemble:mediumGearMount .
reassemble:mediumGearMount a reassemble:GearMount .

reassemble:largeGear a reassemble:Gear ;
    reassemble:datasetObjectLabel "large gear" ;
    reassemble:compatibleSite reassemble:largeGearMount .
reassemble:largeGearMount a reassemble:GearMount .

reassemble:roundPeg1 a reassemble:Peg ;
    reassemble:datasetObjectLabel "round peg 1" ;
    reassemble:compatibleSite reassemble:roundPegHole1 .
reassemble:roundPegHole1 a reassemble:PegHole .

reassemble:roundPeg2 a reassemble:Peg ;
    reassemble:datasetObjectLabel "round peg 2" ;
    reassemble:compatibleSite reassemble:roundPegHole2 .
reassemble:roundPegHole2 a reassemble:PegHole .

reassemble:roundPeg3 a reassemble:Peg ;
    reassemble:datasetObjectLabel "round peg 3" ;
    reassemble:compatibleSite reassemble:roundPegHole3 .
reassemble:roundPegHole3 a reassemble:PegHole .

reassemble:roundPeg4 a reassemble:Peg ;
    reassemble:datasetObjectLabel "round peg 4" ;
    reassemble:compatibleSite reassemble:roundPegHole4 .
reassemble:roundPegHole4 a reassemble:PegHole .

reassemble:squarePeg1 a reassemble:Peg ;
    reassemble:datasetObjectLabel "square peg 1" ;
    reassemble:compatibleSite reassemble:squarePegHole1 .
reassemble:squarePegHole1 a reassemble:PegHole .

reassemble:squarePeg2 a reassemble:Peg ;
    reassemble:datasetObjectLabel "square peg 2" ;
    reassemble:compatibleSite reassemble:squarePegHole2 .
reassemble:squarePegHole2 a reassemble:PegHole .

reassemble:squarePeg3 a reassemble:Peg ;
    reassemble:datasetObjectLabel "square peg 3" ;
    reassemble:compatibleSite reassemble:squarePegHole3 .
reassemble:squarePegHole3 a reassemble:PegHole .

reassemble:squarePeg4 a reassemble:Peg ;
    reassemble:datasetObjectLabel "square peg 4" ;
    reassemble:compatibleSite reassemble:squarePegHole4 .
reassemble:squarePegHole4 a reassemble:PegHole .

reassemble:m16Nut a reassemble:ThreadedPart ;
    reassemble:datasetObjectLabel "bolt 4" ;
    reassemble:compatibleSite reassemble:m16NutMount .
reassemble:m16NutMount a reassemble:ThreadedMount .
