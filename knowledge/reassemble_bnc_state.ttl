@prefix reassemble: <https://example.org/reassemble/actions#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dul: <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#> .
@prefix soma: <http://www.ease-crc.org/ont/SOMA.owl#> .

<https://example.org/reassemble/bnc-state> a owl:Ontology .

reassemble:Workstation a owl:Class ;
    rdfs:subClassOf dul:DesignedArtifact .
reassemble:bncWorkstation a reassemble:Workstation ;
    soma:hasPhysicalComponent reassemble:bncSocket .
reassemble:robotArm a soma:Arm ;
    soma:hasPhysicalComponent reassemble:gripper .
reassemble:gripper a soma:Gripper .

# Bridge the saved pilot observations to the shared model without changing their IDs.
reassemble:BncSnapshot a owl:Class ;
    rdfs:subClassOf reassemble:ManipulationSnapshot .
reassemble:observedConnector a owl:ObjectProperty ;
    rdfs:subPropertyOf reassemble:observedPiece ;
    rdfs:domain reassemble:BncSnapshot ;
    rdfs:range reassemble:Connector .
reassemble:observedSocket a owl:ObjectProperty ;
    rdfs:subPropertyOf reassemble:observedSite ;
    rdfs:domain reassemble:BncSnapshot ;
    rdfs:range reassemble:Socket .
reassemble:SocketEngagement a owl:Class ;
    rdfs:subClassOf reassemble:SiteEngagement .
reassemble:seated a reassemble:SocketEngagement .
reassemble:separated a reassemble:SocketEngagement .
reassemble:socketEngagement a owl:ObjectProperty ;
    rdfs:subPropertyOf reassemble:siteEngagement ;
    rdfs:domain reassemble:BncSnapshot ;
    rdfs:range reassemble:SocketEngagement .
