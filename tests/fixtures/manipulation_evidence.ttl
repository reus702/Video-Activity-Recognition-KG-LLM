@prefix reassemble: <https://example.org/reassemble/actions#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Synthetic action evidence examples with separate clip provenance.

reassemble:gearLifted a reassemble:ManipulationSnapshot ;
    reassemble:recordingId "synthetic-recording" ;
    reassemble:clipId "synthetic-gear" ;
    reassemble:observedAt "4"^^xsd:double ;
    reassemble:observedGripper reassemble:gripper ;
    reassemble:observedPiece reassemble:smallGear ;
    reassemble:observedSupport reassemble:reviewTable ;
    reassemble:supportStatus reassemble:offSupport ;
    reassemble:gripStatus reassemble:held .

reassemble:gearBackOnTable a reassemble:ManipulationSnapshot ;
    reassemble:recordingId "synthetic-recording" ;
    reassemble:clipId "synthetic-gear" ;
    reassemble:observedAt "5"^^xsd:double ;
    reassemble:observedGripper reassemble:gripper ;
    reassemble:observedPiece reassemble:smallGear ;
    reassemble:observedSupport reassemble:reviewTable ;
    reassemble:supportStatus reassemble:onSupport ;
    reassemble:gripStatus reassemble:unheld .

