@prefix reassemble: <https://example.org/reassemble/actions#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

reassemble:pegAtSite a reassemble:ManipulationSnapshot ;
    reassemble:recordingId "synthetic-recording" ;
    reassemble:clipId "synthetic-peg" ;
    reassemble:observedPiece reassemble:roundPeg4 ;
    reassemble:observedSite reassemble:roundPegHole4 ;
    reassemble:observedGripper reassemble:gripper ;
    reassemble:siteEngagement reassemble:seated ;
    reassemble:gripStatus reassemble:unheld ;
    reassemble:gripperOccupancy reassemble:empty ;
    reassemble:observedAt "2.0"^^xsd:double .

reassemble:reviewTable a reassemble:FreeSupport .
reassemble:gearOnTable a reassemble:ManipulationSnapshot ;
    reassemble:recordingId "synthetic-recording" ;
    reassemble:clipId "synthetic-gear" ;
    reassemble:observedPiece reassemble:smallGear ;
    reassemble:observedSupport reassemble:reviewTable ;
    reassemble:observedGripper reassemble:gripper ;
    reassemble:supportStatus reassemble:onSupport ;
    reassemble:gripStatus reassemble:unheld ;
    reassemble:observedAt "3.0"^^xsd:double .
